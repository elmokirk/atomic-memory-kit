{
  "name": "atomic-memory-kit",
  "version": "0.2.0",
  "description": "Bidirectional atomic memory for agents: compile a Markdown knowledge graph into one context bundle, decompile it back into atoms, and spotlight what is missing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "amk": "./cli/amk.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapters/fs": "./adapters/fs.ts",
    "./adapters/memory-tool": "./adapters/memory-tool.ts",
    "./adapters/mem0": "./adapters/mem0.ts"
  },
  "files": [
    "src",
    "adapters",
    "cli",
    "agent",
    "docs",
    "PRODUCT.md",
    "CONCEPT.md",
    "CONTRACT.md",
    "LIMITATIONS.md",
    "ANALYSIS-ANTHROPIC-MEMORY.md",
    "SOURCEMAP.md",
    "LINKMAP.md",
    "VERDICT.md",
    "IDEAS.md"
  ],
  "scripts": {
    "validate": "node cli/amk.mjs validate",
    "compile": "node cli/amk.mjs compile",
    "decompile": "node cli/amk.mjs decompile",
    "index": "node cli/amk.mjs index",
    "eval": "node cli/amk.mjs eval",
    "gaps": "node cli/amk.mjs gaps",
    "drift": "node cli/amk.mjs drift",
    "test": "node --test \"tests/*.test.ts\"",
    "demo": "node example/chatbot/demo.mjs",
    "check": "cd example && node ../cli/amk.mjs validate && node ../cli/amk.mjs eval && cd .. && npm test",
    "mcp": "cd example && node ../agent/mcp-server.mjs --config ./memory.config.json",
    "mcp:http": "cd example && node ../agent/mcp-server.mjs --config ./memory.config.json --http 8787",
    "contract": "node cli/amk.mjs contract",
    "expiring": "node cli/amk.mjs expiring"
  },
  "keywords": [
    "agent-memory",
    "knowledge-management",
    "second-brain",
    "markdown",
    "rag",
    "retrieval",
    "knowledge-graph",
    "gap-analysis",
    "claude-code",
    "mcp"
  ],
  "dependencies": {},
  "devDependencies": {}
}
