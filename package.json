{
  "name": "atomic-memory-kit",
  "version": "0.2.0",
  "description": "Bidirectional atomic memory for agents: compile a Markdown knowledge graph into one context bundle, decompile it back into atoms, and spotlight what is missing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "amk": "./cli/amk.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapters/fs": "./adapters/fs.ts"
  },
  "files": [
    "src",
    "adapters",
    "cli",
    "agent",
    "docs",
    "CONCEPT.md",
    "CONTRACT.md",
    "LIMITATIONS.md",
    "ANALYSIS-ANTHROPIC-MEMORY.md"
  ],
  "scripts": {
    "validate": "node cli/amk.mjs validate",
    "compile": "node cli/amk.mjs compile",
    "decompile": "node cli/amk.mjs decompile",
    "index": "node cli/amk.mjs index",
    "eval": "node cli/amk.mjs eval",
    "gaps": "node cli/amk.mjs gaps",
    "drift": "node cli/amk.mjs drift",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "node cli/amk.mjs validate && node cli/amk.mjs eval && npm run test",
    "mcp": "node agent/mcp-server.mjs --config ./memory.config.json",
    "mcp:http": "node agent/mcp-server.mjs --config ./memory.config.json --http 8787",
    "contract": "node -e \"import(\"./src/contract.ts\").then(m=>console.log(JSON.stringify(m.describeContract(),null,2)))\""
  },
  "keywords": [
    "agent-memory",
    "knowledge-management",
    "second-brain",
    "markdown",
    "rag",
    "retrieval",
    "knowledge-graph",
    "gap-analysis",
    "claude-code",
    "mcp"
  ],
  "dependencies": {},
  "devDependencies": {}
}
